{
  "name": "type",
  "version": "1.7.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "键盘模拟输入器 (Go + WebView2 + Vue 3 + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"test/**/*.ts\" \"tools/**/*.mjs\" \"*.json\" \"*.ts\" \"index.html\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"test/**/*.ts\" \"tools/**/*.mjs\" \"*.json\" \"*.ts\" \"index.html\"",
    "test": "node --import ./test/ts-resolve.mjs --test test/*.test.ts"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vue-tsc": "^3.0.0"
  }
}
