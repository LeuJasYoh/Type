#include <winver.h>

// 应用程序图标
IDI_ICON1       ICON    "source/icon.ico"

// 版本信息
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,3,1,0
 PRODUCTVERSION  1,3,1,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "LeuJasYoh"
            VALUE "FileDescription",  "Type - Keyboard Input Simulator"
            VALUE "FileVersion",      "1.3.1.0"
            VALUE "InternalName",     "Type"
            VALUE "LegalCopyright",   "Copyright (C) 2025-2026 LeuJasYoh"
            VALUE "OriginalFilename", "Type.exe"
            VALUE "ProductName",      "Type"
            VALUE "ProductVersion",   "1.3.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
